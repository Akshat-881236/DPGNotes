rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /* ---------------- USERS ---------------- */

    match /users/{userId} {

      allow read: if true;

      allow write: if request.auth != null;
    }

    /* -------------- DOCUMENTS -------------- */

    match /documents/{docId} {

      // Public Read
      allow read: if true;

      // Authenticated Upload
      allow create:
      if request.auth != null
      &&
      validateDocument();

      // Only uploader can edit/delete, EXCEPT for likes array, AND admin can do anything
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    /* ---------- ACTIVITY LOGS ---------- */
    match /activity_logs/{logId} {
      allow create: if true;
      allow read: if true;
    }

    /* ---------- NOTIFICATIONS ---------- */
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.email == request.auth.token.email;
      allow create: if request.auth != null; 
      allow update, delete: if request.auth != null && resource.data.email == request.auth.token.email;
    }

    /* ---------- SHARE LINKS ---------- */
    match /share_links/{tokenId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    /* ---------- SHARE ENGAGEMENTS ---------- */
    match /share_engagements/{engId} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    /* ---------- SECURITY VIOLATIONS ---------- */
    match /security_violations/{violId} {
      allow read, write: if request.auth != null;
    }

    /* ---------- PERMANENT BLOCKS ---------- */
    match /permanent_blocks/{blockId} {
      allow read, write: if true;
    }

    /* ---------- ACTIVE SESSIONS ---------- */
    match /active_sessions/{sessId} {
      allow read, write: if true;
    }
    
    /* ---------- VALIDATION ---------- */

    function validateDocument() {

      return request.resource.data.keys().hasAll([
        'category',
        'discipline',
        'title',
        'description',
        'tags',
        'documentId',
        'pdfUrl',
        'createdAt',
        'userId',
        'userName'
      ])

      &&

      request.resource.data.category in [

        'SE',
        'SP',
        'UE',
        'EV',
        'T&N',
        'IQ',
        'A&LR',
        'PQ'
      ]

      &&

      request.resource.data.title is string

      &&

      request.resource.data.description is string

      &&

      request.resource.data.tags is list

      &&

      request.resource.data.documentId is string

      &&

      request.resource.data.pdfUrl is string

      &&

      request.resource.data.userId is string

      &&

      request.resource.data.userName is string;
    }
  }
}