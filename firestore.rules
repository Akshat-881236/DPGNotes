rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /* ---------------- USERS ---------------- */

    match /users/{userId} {

      allow read: if true;

      allow write: if request.auth != null;
    }

    /* -------------- DOCUMENTS -------------- */

    match /documents/{docId} {

      // Public Read
      allow read: if true;

      // Authenticated Upload
      allow create:
      if request.auth != null
      &&
      validateDocument();

      // Only uploader can edit/delete, EXCEPT for likes array, AND admin can do anything
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    /* ---------- ACTIVITY LOGS ---------- */
    match /activity_logs/{logId} {
      allow create: if true;
      allow read: if true;
    }

    /* ---------- NOTIFICATIONS ---------- */
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    /* ---------- SHARE LINKS ---------- */
    match /share_links/{tokenId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    /* ---------- SHARE ENGAGEMENTS ---------- */
    match /share_engagements/{engId} {
      allow read, write: if true;
    }

    /* ---------- SECURITY VIOLATIONS ---------- */
    match /security_violations/{violId} {
      allow read, write: if true;
    }

    /* ---------- PERMANENT BLOCKS ---------- */
    match /permanent_blocks/{blockId} {
      allow read, write: if true;
    }

    /* ---------- ACTIVE SESSIONS ---------- */
    match /active_sessions/{sessId} {
      allow read, write: if true;
    }

    /* ---------- FOLLOWS ---------- */
    match /follows/{followId} {
      allow read, write: if true;
    }

    /* ---------- CONNECTIONS ---------- */
    match /connections/{connectionId} {
      allow read, write: if true;
    }

    /* ---------- GROUP MESSAGES ---------- */
    match /group_messages/{msgId} {
      allow read, write: if true;
    }

    /* ---------- SUPPORT TOKENS ---------- */
    match /support_tokens/{tokenId} {
      allow read, write: if true;
    }

    /* ---------- SUPPORT REQUESTS ---------- */
    match /support_requests/{reqId} {
      allow read, write: if true;
    }

    /* ---------- SHORTENED URLS ---------- */
    match /shortened_urls/{urlId} {
      allow read, write: if true;
    }

    match /invitations/{invitationId} {
      allow read, write: if true;
    }
    
    /* ---------- DEVICE LOGIN HISTORY ---------- */
    match /device_login_history/{logId} {
      allow read, write: if true;
    }

    /* ---------- GUEST QUOTAS ---------- */
    match /guest_quotas/{quotaId} {
      allow read, write: if true;
    }

    /* ---------- RESOURCE KNOWLEDGE ---------- */
    match /resource_knowledge/{rkId} {
      allow read, write: if true;
    }

    /* ---------- BLOGS ---------- */
    match /blogs/{blogId} {
      allow read, write: if true;
    }

    /* ---------- PENDING APPROVALS ---------- */
    match /pending_approvals/{approvalId} {
      allow read, write: if true;
    }
    
    
    /* ---------- VALIDATION ---------- */

    function validateDocument() {

      return request.resource.data.keys().hasAll([
        'category',
        'discipline',
        'title',
        'description',
        'tags',
        'documentId',
        'pdfUrl',
        'createdAt',
        'userId',
        'userName'
      ])

      &&

      request.resource.data.category in [

        'SE',
        'SP',
        'UE',
        'EV',
        'T&N',
        'IQ',
        'A&LR',
        'PQ'
      ]

      &&

      request.resource.data.title is string

      &&

      request.resource.data.description is string

      &&

      request.resource.data.tags is list

      &&

      request.resource.data.documentId is string

      &&

      request.resource.data.pdfUrl is string

      &&

      request.resource.data.userId is string

      &&

      request.resource.data.userName is string;
    }
  }
}