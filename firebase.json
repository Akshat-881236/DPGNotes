{
  "firestore": {

    "rules":
    "firestore.rules",

    "indexes":
    "firestore.indexes.json"
  },

  "hosting": {

    "site": "dpgnotes",

    "public":
    "public",

    "redirects": [
      {
        "source": "/legal/advertising_policy.html",
        "destination": "/legal/advertising-policy.html",
        "type": 301
      }
    ],

    "ignore": [

      "firebase.json",

      "**/.*",

      "**/node_modules/**"
    ],

    "headers": [
      {
        "source": "**/*.@(pdf|jpg|jpeg|png|webp|svg)",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Access-Control-Allow-Methods",
            "value": "GET, OPTIONS"
          },
          {
            "key": "Access-Control-Allow-Headers",
            "value": "*"
          }
        ]
      }
    ]
  }
}